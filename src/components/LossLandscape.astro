---
// Top-down contour map of a loss landscape with a gradient descent path, in the spirit of sonnet.io's sketch.
// Contours come from marching squares over a grid; the path follows the true numerical gradient.
const f = (x: number, y: number) =>
  0.07 * (x * x + y * y)
  - 0.9 * Math.exp(-((x - 0.7) ** 2 + (y - 0.5) ** 2) / 0.7)
  - 0.45 * Math.exp(-((x + 1.3) ** 2 + (y + 1.1) ** 2) / 0.35)
  + 0.4 * Math.exp(-((x + 0.3) ** 2 + (y - 1.7) ** 2) / 0.35)
  + 0.07 * Math.sin(2.0 * x) * Math.cos(1.7 * y);

const R = 2.6, N = 140, W = 400;
const toPx = (v: number) => ((v + R) / (2 * R)) * W;
const grid = Array.from({ length: N + 1 }, (_, i) =>
  Array.from({ length: N + 1 }, (_, j) => f(-R + (2 * R * j) / N, -R + (2 * R * i) / N)));

const flat = grid.flat();
const lo = Math.min(...flat), hi = Math.max(...flat);
const levels = Array.from({ length: 16 }, (_, k) => lo + ((k + 0.5) * (hi - lo)) / 16);

// Marching squares: one SVG path per contour level.
const cell = W / N;
const contours = levels.map((t) => {
  let d = '';
  for (let i = 0; i < N; i++) {
    for (let j = 0; j < N; j++) {
      const a = grid[i][j], b = grid[i][j + 1], c = grid[i + 1][j + 1], e = grid[i + 1][j];
      const pts: [number, number][] = [];
      const edge = (v0: number, v1: number, x0: number, y0: number, x1: number, y1: number) => {
        if ((v0 < t) !== (v1 < t)) {
          const s = (t - v0) / (v1 - v0);
          pts.push([(x0 + s * (x1 - x0)) * cell, (y0 + s * (y1 - y0)) * cell]);
        }
      };
      edge(a, b, j, i, j + 1, i);
      edge(b, c, j + 1, i, j + 1, i + 1);
      edge(e, c, j, i + 1, j + 1, i + 1);
      edge(a, e, j, i, j, i + 1);
      for (let k = 0; k + 1 < pts.length; k += 2) {
        d += `M${pts[k][0].toFixed(1)} ${pts[k][1].toFixed(1)}L${pts[k + 1][0].toFixed(1)} ${pts[k + 1][1].toFixed(1)}`;
      }
    }
  }
  return d;
});

// Plain gradient descent from a high point, using a numerical gradient.
let x = -1.75, y = 1.55;
const path: [number, number][] = [];
for (let k = 0; k < 60; k++) {
  path.push([x, y]);
  const h = 1e-3;
  const gx = (f(x + h, y) - f(x - h, y)) / (2 * h);
  const gy = (f(x, y + h) - f(x, y - h)) / (2 * h);
  x -= 0.4 * gx; y -= 0.4 * gy;
}
const walk = path.map(([a, b]) => `${toPx(a).toFixed(1)},${toPx(b).toFixed(1)}`).join(' ');
const [ex, ey] = path[path.length - 1];
const ticks = [0.2, 0.4, 0.6, 0.8].map((r) => r * W);
---
<figure class="sketch" aria-hidden="true">
  <svg viewBox={`-10 -4 ${W + 16} ${W + 16}`} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <defs><clipPath id="plot-area"><rect width={W} height={W} /></clipPath></defs>
    <g clip-path="url(#plot-area)">
      {contours.map((d, k) => <path d={d} stroke-width={k % 4 === 0 ? 1.6 : 0.9} />)}
    </g>
    <rect width={W} height={W} stroke-width="1.6" />
    {ticks.map((t) => (
      <>
        <path d={`M${t} ${W}v7`} stroke-width="1.4" />
        <path d={`M0 ${t}h-7`} stroke-width="1.4" />
      </>
    ))}
    <polyline points={walk} stroke-width="2" stroke-dasharray="1 6" />
    {path.filter((_, i) => i % 5 === 0).map(([a, b]) => (
      <circle cx={toPx(a)} cy={toPx(b)} r="3.5" style="fill: var(--bg)" stroke-width="1.6" />
    ))}
    <circle cx={toPx(ex)} cy={toPx(ey)} r="6" style="fill: var(--text)" stroke="none" />
  </svg>
  <figcaption>↑ hoping this isn't a local minimum</figcaption>
</figure>
