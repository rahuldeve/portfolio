---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Writing" description="Notes on machine learning, data and the things I build.">
  <h1>Writing</h1>
  <p class="meta">Notes on machine learning, data and the things I build. <a href="/rss.xml">RSS</a></p>
  <ul class="post-list">
    {posts.map((p) => (
      <li><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time><a href={`/blog/${p.id}/`}>{p.data.title}</a></li>
    ))}
  </ul>
</Base>
